        [SerializeField] private string lastNotificationMessage = "";

        /// <summary>
        /// Current spool physical outer radius in meters, calibrated to 10.0mm at stroke 0 to 14.4mm at stroke 4.
        /// Source mesh outer radius is 10.8mm (0.0108m), so physical radius = 0.0108m * localScale.x.
        /// </summary>
        public float CurrentSpoolRadius
        {
            get
            {
                if (spooledWebbingTransform != null)
                    return SOURCE_SPOOL_MESH_RADIUS * spooledWebbingTransform.localScale.x;
                float maxShortening = MAX_TIGHTEN_STROKES * shorteningPerTooth;
                float progress = maxShortening > 0.0001f ? Mathf.Clamp01(targetShortening / maxShortening) : (completedStrokes / (float)MAX_TIGHTEN_STROKES);
                return MIN_SPOOL_RADIUS + progress * (MAX_SPOOL_RADIUS - MIN_SPOOL_RADIUS);
            }
        }

        /// <summary>
        /// Normalized tightening progress from 0.0 (stroke 0) to 1.0 (stroke 4).
        /// </summary>
        public float CurrentProgress
        {
            get
            {
                float maxShortening = MAX_TIGHTEN_STROKES * shorteningPerTooth;
                return maxShortening > 0.0001f ? Mathf.Clamp01(targetShortening / maxShortening) : (completedStrokes / (float)MAX_TIGHTEN_STROKES);
            }
        }
